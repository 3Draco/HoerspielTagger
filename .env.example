# LLM API Configuration
# Option A: Local LM Studio (Default)
LLM_API_BASE_URL=http://127.0.0.1:1234/v1
LLM_API_KEY=lm-studio
LLM_MODEL_ID=meta-llama-3-8b-instruct

# Option B: Custom Agent API
# LLM_API_BASE_URL=https://your-custom-api.com/v1
# LLM_API_KEY=your-custom-agent-key
# LLM_MODEL_ID=agent_1234567890

# Option C: OpenAI API
# LLM_API_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=your-openai-key
# LLM_MODEL_ID=gpt-4o-mini

# Threshold for merging MP3 tracks (Lossless merge)
MERGE_THRESHOLD=10
